{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./dist-lib",
    "types": ["vite/client"]
  },
  "include": [
    "src/index.ts",
    "src/components/SketchCanvas.tsx",
    "src/components/SketchToolbar.tsx",
    "src/components/ColorTemplatePicker.tsx",
    "src/components/GradientCreator.tsx",
    "src/hooks/useSketchLayer.ts",
    "src/pro/**/*.ts",
    "src/pro/**/*.tsx",
    "src/lib/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/lib/demo.ts"]
}
